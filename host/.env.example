# ClaudeTV collector config. Copy to .env (or just edit live in the master terminal).
# The Claude OAuth token is read from the credentials store, NOT from this file.
CLAUDETV_CITY=Melbourne
CLAUDETV_LAT=-37.8136
CLAUDETV_LON=144.9631
CLAUDETV_TZ=Australia/Melbourne
# Each `cswap list --json` refreshes cswap's stalest account, so with N accounts a given account
# lands every ~N polls: 90s keeps two accounts under ~3 minutes stale.
CLAUDETV_USAGE_EVERY=90
CLAUDETV_WEATHER_EVERY=900
CLAUDETV_PORT=8088

# --- Accounts -----------------------------------------------------------------------------
# MULTI-ACCOUNT: install claude-swap (pipx install claude-swap) and add each account
# (`cswap add --alias work`). The collector then reads every account from it and the display
# cycles through them. Without cswap it falls back to the single-account keeper below.
CLAUDETV_CSWAP_BIN=                      # blank = auto: ./venv/bin/cswap, else cswap on PATH
CLAUDETV_CSWAP_ACCOUNTS=                 # blank = all; else a comma list that filters AND orders
                                         # e.g. work,personal  (matches alias, email or slot)
CLAUDETV_ACCOUNT_LABEL=CLAUDE            # label for the single account in native (non-cswap) mode
# Credentials path, native mode only. Blank = auto: the collector's own store (created by
# --login, lives beside the script), else a co-located Claude Code login at
# ~/.claude/.credentials.json. Ignored when cswap is driving: cswap owns credentials then, and
# the collector's keeper stands down so the two never rotate the same token family.
CLAUDE_CREDENTIALS=

# --- Reset notifications (easiest to set from the master terminal's Notifications card) ---
# Ping you when a Claude usage window rolls over to a fresh quota.
CLAUDETV_NOTIFY_SESSION_RESET=false      # 5-hour session window
CLAUDETV_NOTIFY_WEEK_RESET=false         # 7-day week window (the Fable % rides in this message)
CLAUDETV_NOTIFY_AUTH=true                # auth outage / standby-failover / recovery alerts
# Discord / Slack: paste an incoming-webhook URL to enable that channel.
CLAUDETV_NOTIFY_DISCORD_WEBHOOK=
CLAUDETV_NOTIFY_SLACK_WEBHOOK=
# Email over SMTP:
CLAUDETV_NOTIFY_EMAIL=false
CLAUDETV_SMTP_HOST=
CLAUDETV_SMTP_PORT=587
CLAUDETV_SMTP_SECURITY=starttls          # starttls | ssl | none
CLAUDETV_SMTP_FROM=
CLAUDETV_SMTP_USER=
CLAUDETV_SMTP_PASS=
CLAUDETV_NOTIFY_EMAIL_TO=
